name: C3X 0.24 P4 July256 Prospective Physical TT FIRST Human-Git-Presealed M4 vs M0
# FIRST experiment forbidden until original 256game x four role exact six-model UCI human Git preseal exists.
# Model M4 locked before July source and all original source/stage/forecast SHA gated at runtime.
on:
  push:
    paths:
      - '.github/workflows/c3x-024-P4-July256-physical-FIRST-after-human-git-1024role-seal.yml'
  workflow_dispatch:
permissions:
  contents: read
jobs:
  prospective-native-FIRST-sharded:
    strategy:
      fail-fast: false
      matrix:
        shard: [0, 1, 2, 3]
    runs-on: ubuntu-latest
    timeout-minutes: 150
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: '3.12'
      - name: Human Git complete exact 1024 role M4 and comparators before ANY July FIRST
        run: |
          set -euo pipefail
          python -m pip install -q chess==1.11.2 zstandard==0.25.0
          python -m py_compile harness/c3x_024_P4_preFIRST_1024role_human_Git_literal_gate.py harness/c3x_024_P4_July256_sharded_native_TT_FIRST_after_human_Git_M4_UCI.py
          test -f c3x/forecasts/c3x-024-P4-July2025-256game-1024role-six-model-literal-UCI-before-FIRST-human-Git-seal-20261011.json
          python - <<'PY'
          import json
          d=json.load(open('c3x/forecasts/c3x-024-P4-July2025-256game-1024role-six-model-literal-UCI-before-FIRST-human-Git-seal-20261011.json'))
          assert d['schema']=='c3x024-P4-July2025-256games-1024role-six-model-HUMAN_GIT_literal-before-FIRST-v1'
          assert len(d['ordered_games_literal_rows'])==256
          assert sum(len(x[2]) for x in d['ordered_games_literal_rows'])==1024
          assert d['phase']=='BEFORE_ANY_JULY_NATIVE_TT_FIRST_TREATED_OUTCOME'
          assert d['source_JSON_SHA256']=='d2c50a1293e68c3feb8571d1ee1be6ba1a7ee539a12dd1a98378adfa9b54fb58'
          print('C3X024_P4_HUMAN_GIT_ALL_1024ROLE_SIX_MODEL_EXACT_UCI_PRIOR_TO_FIRST_PASS')
          PY
          mkdir -p source stageA forecast evidence public
      - uses: actions/download-artifact@v4
        with:
          name: c3x-024-P4-JULY2025-256independent-SOURCE-ONLY-before-M4
          path: source/
          repository: WhoSia/C3X
          run-id: '38083154595'
          github-token: ${{ github.token }}
      - uses: actions/download-artifact@v4
        with:
          name: c3x-024-P4-JULY2025-256-untreated-native-O-F-SEE-no-treatment
          path: stageA/
          repository: WhoSia/C3X
          run-id: '38089656512'
          github-token: ${{ github.token }}
      - uses: actions/download-artifact@v4
        with:
          name: c3x-024-P4-July256-six-model-literal-1024role-UCI-preFIRST
          path: forecast/
          repository: WhoSia/C3X
          run-id: 'FORECAST_RUN_ID_PLACEHOLDER'
          github-token: ${{ github.token }}
      - name: Byte exact source StageA and 1024 role human Git preFIRST integrity court
        run: |
          set -euo pipefail
          python -u harness/c3x_024_P4_preFIRST_1024role_human_Git_literal_gate.py --source source/C3X024_P4_JULY2025_ENGINEBLIND_256.json --stagea stageA/C3X024_P4_JULY2025_STAGEA_UNTREATED_NATIVE256.json --forecast forecast/C3X024_P4_JULY256_SIX_MODELS_EXACT_UCI_PRE_FIRST.json --seal c3x/forecasts/c3x-024-P4-July2025-256game-1024role-six-model-literal-UCI-before-FIRST-human-Git-seal-20261011.json
      - name: Native Stockfish16 single-return plus second-return and persistent-state build
        run: |
          set -euo pipefail
          root=/tmp/C3X020_MULTI_STATE
          git clone -q --single-branch --branch sf_16 https://github.com/official-stockfish/Stockfish.git "$root"
          test "$(git -C "$root" rev-parse HEAD)" = 68e1e9b3811e16cad014b590d7443b9063b3eb52
          python tools/c3x_016_P4_independent_12root_source_order_patch.py --source "$root" --out-manifest evidence/P4.json
          python tools/c3x_017_early_depth1_root_window_trace_patch.py --source "$root" --out-manifest evidence/ROOT_TRACE.json
          python tools/c3x_018_trial_call_identity_patch.py --source "$root" --out-manifest evidence/TRIAL_ID.json
          python tools/c3x_018_physical_epoch_lineage_patch.py --source "$root" --out-manifest evidence/EPOCH.json
          python tools/c3x_018_tt_eval_consumption_overlay.py --source "$root" --out-manifest evidence/V.json
          python tools/c3x_018_physical_value_witness_overlay.py --source "$root" --out-manifest evidence/WRITER_TICKET.json
          python tools/c3x_018_root_TT_genealogy_overlay.py --source "$root" --out-manifest evidence/ROOT_TT_LINEAGE.json
          python tools/c3x_018_TT_reader_writer_age_bound_root_feature_overlay.py --source "$root" --out-manifest evidence/AGE_BOUND.json
          python tools/c3x_018_january2048_TT_reader_source_census.py --source "$root" --out-manifest evidence/CENSUS.json
          python tools/c3x_018_adaptive_writer_age_root_call_V_gate.py --source "$root" --out-manifest evidence/AGE_GATE.json
          python tools/c3x_018_january_cross_window_pair_source_gate.py --source "$root" --out-manifest evidence/WINDOW_GATE.json
          python tools/c3x_018_jan_original_key_TT_probe_watch_overlay.py --source "$root" --out-manifest evidence/PROBE.json
          python tools/c3x_018_jan_TT_probe_physical_writer_epoch_witness.py --source "$root" --out-manifest evidence/PROBE_WRITER.json
          python tools/c3x_018_P0P1_TT_save_decision_writer_reinstate_overlay.py --source "$root" --out-manifest evidence/P0_P1_SOURCE_MUTATION.json
          python tools/c3x_018_P1_pre_second_reader_temporal_scope_overlay.py --source "$root" --out-manifest evidence/P1_PRE_SECOND_TEMPORAL_GATE.json
          python tools/c3x_019_tt_raw_bytes_shadow_writer_orthogonal_overlay.py --source "$root" --out-manifest evidence/C3X019_ORTHOGONAL_WRITER_STATE.json
          python tools/c3x_019_actual_native_tt_eval_use_source_witness.py --source "$root" --out-manifest evidence/C3X019_NATIVE_EVAL_USE.json
          python tools/c3x_019_native_TT_cutoff_actual_return_overlay.py --source "$root" --out-manifest evidence/C3X019_NATIVE_TT_CUTOFF_RETURN.json
          python tools/c3x_019_root_return_one_site_rescue_overlay.py --source "$root" --out-manifest evidence/ONE_SITE_RETURN_MUTATION.json
          python tools/c3x_020_multi_state_root_repair_overlay.py --source "$root" --out-manifest evidence/C3X020_MULTI_STATE_MUTATION.json
          python tools/c3x_022_P2_R2_native_SEE_source_witness_overlay.py --source "$root" --out-manifest evidence/C3X022_R2_NATIVE_SEE_FOUR_SOURCE_SITES.json
          python tools/c3x_022_P2_R2_D1_rootcall_only_SEE_observer.py --source "$root" --out-manifest evidence/C3X022_R2_D1_DESCENDANT_READONLY.json
          python tools/c3x_023_P1_native_SEE_parent_path_key_overlay.py --source "$root" --out-manifest evidence/C3X023_P1_MAIN_QSEARCH_ANCESTRY_KEYPATH.json
          git -C "$root" diff -- src/ > /tmp/C3X023_GPL_MODIFIED_ENGINE_SOURCE.diff
          sha256sum /tmp/C3X023_GPL_MODIFIED_ENGINE_SOURCE.diff | awk '{print $1 "  GPL_DIFF_PRIVATE_NOT_UPLOADED"}' > evidence/MODIFIED_GPL_DIFF_SHA256.txt
          make -s -C "$root/src" -j2 build ARCH=x86-64
          sha256sum "$root/src/stockfish" | awk '{print $1 "  MODIFIED_ENGINE_BINARY_NOT_UPLOADED"}' > evidence/BINARY_SHA256.txt
      - name: Perform original source physically REAL TT FIRST shard ${{ matrix.shard }} after Git preseal
        run: |
          set -euo pipefail
          python -u harness/c3x_024_P4_July256_sharded_native_TT_FIRST_after_human_Git_M4_UCI.py --source source/C3X024_P4_JULY2025_ENGINEBLIND_256.json --stagea stageA/C3X024_P4_JULY2025_STAGEA_UNTREATED_NATIVE256.json --forecast forecast/C3X024_P4_JULY256_SIX_MODELS_EXACT_UCI_PRE_FIRST.json --seal c3x/forecasts/c3x-024-P4-July2025-256game-1024role-six-model-literal-UCI-before-FIRST-human-Git-seal-20261011.json --engine /tmp/C3X020_MULTI_STATE/src/stockfish --shard ${{ matrix.shard }} --out public/C3X024_P4_TREATED_SHARD_${{ matrix.shard }}.json
          python tools/c3x_023_rights_preupload_gate.py --tier P2_AGGREGATE_SUMMARY --file public/C3X024_P4_TREATED_SHARD_${{ matrix.shard }}.json --report public/RIGHTS_P4_NATIVE_SHARD_${{ matrix.shard }}.json
          echo 'Derived paired physical TT FIRST and original-cold Stockfish16 from 2025-07 Lichess broadcast CC BY-SA 4.0 https://database.lichess.org/broadcast/lichess_db_broadcast_2025-07.pgn.zst. Original PGNs/players/FEN and GPL modified engine binary excluded. Rights gate does not imply legal clearance.' > public/SOURCE_LICENSE_ATTRIBUTION.txt
      - name: Public artifact member SHA
        if: always()
        run: |
          mkdir -p public
          find public -maxdepth 1 -type f ! -name MEMBER_SHA256.txt -print0 | sort -z | xargs -0 -r sha256sum > public/MEMBER_SHA256.txt
      - uses: actions/upload-artifact@v4
        if: always()
        with:
          name: c3x-024-P4-July-256game-after-Git-seal-native-FIRST-shard-${{ matrix.shard }}
          path: public/
          if-no-files-found: warn
          retention-days: 90
  prospective-game-clustered-model-court:
    needs: [prospective-native-FIRST-sharded]
    runs-on: ubuntu-latest
    timeout-minutes: 35
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: '3.12'
      - name: Download only four complete read-only original-source TT FIRST shard receipts
        uses: actions/download-artifact@v4
        with:
          pattern: c3x-024-P4-July-256game-after-Git-seal-native-FIRST-shard-*
          path: inputs/
          merge-multiple: true
      - name: Game-clustered M4 versus M0 fair exact-UCI score, 1024 role denominator and predeclared HOLD
        run: |
          set -euo pipefail
          mkdir -p public
          python -u harness/c3x_024_P4_July256_after_human_seal_game_cluster_M4_vs_M0.py --directory inputs --out public/C3X024_P4_JULY256_M4_VS_M0_PROSPECTIVE_GAME_CLUSTER_VERDICT.json
          python tools/c3x_023_rights_preupload_gate.py --tier P2_AGGREGATE_SUMMARY --file public/C3X024_P4_JULY256_M4_VS_M0_PROSPECTIVE_GAME_CLUSTER_VERDICT.json --report public/RIGHTS_PROSPECTIVE_GAME_MODEL_SCAN.json
          echo 'Source official Lichess July2025 broadcast CC BY-SA 4.0, 256 distinct original chess games. Six model exact UCI predictions human Git sealed BEFORE this run. Game-level count and dependence, original complete game/player/FEN excluded. No claim of natural TT SEE mediation or licence from scan.' > public/SOURCE_LICENSE_NOTICE.txt
      - name: Final public aggregate SHA256 manifest
        if: always()
        run: |
          mkdir -p public
          find public -maxdepth 1 -type f ! -name MEMBER_SHA256.txt -print0 | sort -z | xargs -0 -r sha256sum > public/MEMBER_SHA256.txt
      - uses: actions/upload-artifact@v4
        if: always()
        with:
          name: c3x-024-P4-July256-presealed-M4-versus-M0-game-cluster-science-verdict
          path: public/
          if-no-files-found: error
          retention-days: 90
